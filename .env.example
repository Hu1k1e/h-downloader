# ── Radarr ──────────────────────────────────────────────────────────
RADARR_URL=http://YOUR_SERVER_IP:7878
RADARR_API_KEY=your_radarr_api_key_here
RADARR_ROOT_FOLDER=/media
RADARR_QUALITY_PROFILE_ID=1

# ── Jellyseerr ───────────────────────────────────────────────────────
JELLYSEERR_URL=http://YOUR_SERVER_IP:5055
JELLYSEERR_API_KEY=your_jellyseerr_api_key_here

# ── TMDB ─────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ── Einthusan ────────────────────────────────────────────────────────
# Comma-separated list of languages to search
EINTHUSAN_LANGUAGES=malayalam,tamil,telugu,hindi

# ── Optional ─────────────────────────────────────────────────────────
# Days after theatrical release to start checking if no digital date found
DIGITAL_RELEASE_FALLBACK_DAYS=90
# WEBHOOK_SECRET=your_random_secret_here   # HMAC secret for the Jellyseerr webhook

# ── Security (opt-in) ────────────────────────────────────────────────
# Require this token (X-API-Key header) on every /api request. The web UI asks for it once.
# API_AUTH_TOKEN=choose_a_long_random_string
# Require ?token=<value> (or X-Webhook-Token header) on the Radarr/Sonarr webhooks.
# WEBHOOK_TOKEN=choose_another_random_string
# Extra browser origins allowed by CORS (default: same-origin only)
# CORS_ORIGINS=http://localhost:5173

# ── Tuning ───────────────────────────────────────────────────────────
# MAX_CONCURRENT_DOWNLOADS=3

# ── Internal ─────────────────────────────────────────────────────────
DATA_DIR=/app/data
